generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Perfil {
  MEMBRO
  SUPERVISOR
  ADMINISTRADOR
}

enum StatusProjeto {
  EM_ANDAMENTO
  CONCLUIDO
  SUSPENSO
}

enum StatusVinculo {
  ATIVO
  ENCERRADO
  SUSPENSO
}

enum OrigemDocumento {
  UPLOAD
  PASTE
}

model Usuario {
  id                  BigInt    @id @default(autoincrement())
  nomeCompleto        String    @map("nome_completo") @db.VarChar(255)
  cpf                 String    @unique @db.VarChar(14)
  rg                  String?   @db.VarChar(20)
  dataNasc            DateTime? @map("data_nasc") @db.Date
  email               String    @unique @db.VarChar(255)
  senhaHash           String    @map("senha_hash") @db.VarChar(255)
  perfil              Perfil    @default(MEMBRO)
  supervisorId        BigInt?   @map("supervisor_id")
  podeSerCoordenador  Boolean   @default(false) @map("pode_ser_coordenador")
  confirmado          Boolean   @default(true)
  conviteId           BigInt?   @map("convite_id")
  ativo               Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  supervisor      Usuario?             @relation("SupervisaoUsuarios", fields: [supervisorId], references: [id])
  supervisionados Usuario[]            @relation("SupervisaoUsuarios")
  projetosCoord   Projeto[]            @relation("CoordenadorProjeto")
  membros         ProjetoMembro[]
  atividades      Atividade[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  auditLogs       AuditLog[]
  convite         ConviteCadastro?     @relation("UsuarioConvite", fields: [conviteId], references: [id])
  convitesCriados ConviteCadastro[]    @relation("ConviteCriadoPor")

  @@map("usuarios")
}

model ConviteCadastro {
  id          BigInt    @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  descricao   String?   @db.VarChar(255)
  criadoPorId BigInt    @map("criado_por_id")
  usoMaximo   Int       @default(1) @map("uso_maximo")
  usoAtual    Int       @default(0) @map("uso_atual")
  expiraEm    DateTime? @map("expira_em")
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  criadoPor Usuario   @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id])
  usuarios  Usuario[] @relation("UsuarioConvite")

  @@map("convites_cadastro")
}

model Projeto {
  id                      BigInt        @id @default(autoincrement())
  titulo                  String        @db.VarChar(255)
  descricao               String?       @db.Text
  areaTematica            String?       @map("area_tematica") @db.VarChar(255)
  instituicaoExecucao     String?       @map("instituicao_execucao") @db.VarChar(255)
  instituicaoFinanciadora String?       @map("instituicao_financiadora") @db.VarChar(255)
  areaConhecimento        String?       @map("area_conhecimento") @db.VarChar(255)
  dataInicio              DateTime?     @map("data_inicio") @db.Date
  dataFimPrevista         DateTime?     @map("data_fim_prevista") @db.Date
  status                  StatusProjeto @default(EM_ANDAMENTO)
  coordenadorId           BigInt        @map("coordenador_id")
  arquivoPath             String?       @map("arquivo_path") @db.VarChar(512)
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  coordenador Usuario         @relation("CoordenadorProjeto", fields: [coordenadorId], references: [id])
  membros     ProjetoMembro[]
  atividades  Atividade[]

  @@map("projetos")
}

model ProjetoMembro {
  id                  BigInt        @id @default(autoincrement())
  projetoId           BigInt        @map("projeto_id")
  usuarioId           BigInt        @map("usuario_id")
  funcao              String?       @db.VarChar(255)
  isCoordenador       Boolean       @default(false) @map("is_coordenador")
  isBolsista          Boolean       @default(false) @map("is_bolsista")
  valorBolsa          Decimal?      @map("valor_bolsa") @db.Decimal(10, 2)
  duracaoMeses        Int?          @map("duracao_meses")
  dataInicioBolsa     DateTime?     @map("data_inicio_bolsa") @db.Date
  dataFimBolsa        DateTime?     @map("data_fim_bolsa") @db.Date
  cargaHoraria        Int?          @map("carga_horaria")
  planoTrabalhoPath   String?       @map("plano_trabalho_path") @db.VarChar(512)
  resultadosEsperados String?       @map("resultados_esperados") @db.Text
  cronograma          String?       @db.Text
  statusVinculo       StatusVinculo @default(ATIVO) @map("status_vinculo")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  projeto    Projeto   @relation(fields: [projetoId], references: [id])
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  metas      Meta[]

  @@unique([projetoId, usuarioId])
  @@map("projeto_membros")
}

model Meta {
  id              BigInt        @id @default(autoincrement())
  projetoMembroId BigInt        @map("projeto_membro_id")
  descricao       String        @db.Text
  ordem           Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  projetoMembro ProjetoMembro @relation(fields: [projetoMembroId], references: [id], onDelete: Cascade)
  atividades    Atividade[]

  @@map("metas")
}

model Atividade {
  id         BigInt    @id @default(autoincrement())
  projetoId  BigInt    @map("projeto_id")
  usuarioId  BigInt    @map("usuario_id")
  metaId     BigInt?   @map("meta_id")
  titulo     String    @db.VarChar(255)
  descricao  String?   @db.LongText
  dataInicio DateTime? @map("data_inicio") @db.Date
  dataFim    DateTime? @map("data_fim") @db.Date
  concluida  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  projeto    Projeto              @relation(fields: [projetoId], references: [id])
  usuario    Usuario              @relation(fields: [usuarioId], references: [id])
  meta       Meta?                @relation(fields: [metaId], references: [id])
  documentos AtividadeDocumento[]

  @@map("atividades")
}

model AtividadeDocumento {
  id           BigInt          @id @default(autoincrement())
  atividadeId  BigInt          @map("atividade_id")
  nomeOriginal String          @map("nome_original") @db.VarChar(255)
  nomeArquivo  String          @map("nome_arquivo") @db.VarChar(255)
  caminho      String          @db.VarChar(512)
  mimeType     String          @map("mime_type") @db.VarChar(100)
  tamanhoBytes Int             @map("tamanho_bytes")
  origem       OrigemDocumento @default(UPLOAD)
  createdAt    DateTime        @default(now()) @map("created_at")

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@map("atividade_documentos")
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  usuarioId BigInt   @map("usuario_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime @map("expira_em")
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  usuarioId BigInt   @map("usuario_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime @map("expira_em")
  revogado  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("refresh_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  usuarioId  BigInt?  @map("usuario_id")
  acao       String   @db.VarChar(100)
  entidade   String?  @db.VarChar(100)
  entidadeId BigInt?  @map("entidade_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  detalhes   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("audit_log")
}

model ConfiguracaoSistema {
  id         Int      @id @default(1)
  dbHost     String?  @map("db_host") @db.VarChar(255)
  dbPorta    Int      @default(3306) @map("db_porta")
  dbNome     String?  @map("db_nome") @db.VarChar(255)
  dbUsuario  String?  @map("db_usuario") @db.VarChar(255)
  dbSenhaEnc String?  @map("db_senha_enc") @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("configuracao_sistema")
}
